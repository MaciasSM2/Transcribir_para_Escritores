# ─────────────────────────────────────────────────────────────────────────────
# GEMA BACKEND — Configuración de Variables de Entorno
# ─────────────────────────────────────────────────────────────────────────────

# URL base del demonio local de Ollama (por defecto: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo por defecto para refinamiento literario y extracción semántica
OLLAMA_MODEL=llama3

# Ruta al modelo acústico offline de Vosk en español
VOSK_MODEL_PATH=model_es

# Modo estricto para diagnósticos pre-vuelo (0: Permite degradación elegante; 1: Exige que todos los demonios estén activos)
GEMA_STRICT_PREFLIGHT=0

# Configuración de Seguridad JWT (para despliegues multiusuario locales)
SECRET_KEY=tu_clave_secreta_local_generada_aleatoriamente_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
